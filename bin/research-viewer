#!/usr/bin/env -S uv run --quiet --script
# /// script
# requires-python = ">=3.11"
# dependencies = ["polars>=1.0"]
# ///
"""research-viewer — show research outputs in a side pane next to the agent, no Finder hunting.

Commands (run from any pane; inside Claude Code prefix with `!`, or use the /show skill)
  open [--popup]       open the viewer pane on the right (or reuse the one already open);
                       --popup also pops each new chart up in Quick Look (at most one per 20 s)
  close                close the viewer pane
  toggle               close it if open, open it if closed (what Ctrl+B i runs)
  show FILE [FILE...]  display files in the viewer pane, opening it if needed:
                       image -> picture, csv/parquet -> table preview, md/txt/json -> text,
                       html/pdf/svg -> snapshot picture (press o for the live version)
  watch [--popup]      the viewer loop itself (what `open` runs)

Keys inside the viewer
  ← p / → n   older / newer item          [ / ]   previous / next batch
  l           latest                      h       history list (type a number + Enter to jump)
  f           full view: tables scroll in VisiData, text in less, images/HTML in Quick Look
  o           open in Quick Look          q quit viewer     x close pane
Ctrl+B i toggles the pane from anywhere in herdr.

Watched folders: $RESEARCH_VIEWER_ROOTS (colon-separated) or ~/.config/research-viewer/roots
(one per line), else the folder the viewer was opened from; Claude Code scratchpads always.
"""
from __future__ import annotations

import json
import os
import select
import shutil
import subprocess
import sys
import termios
import time
import tty
from dataclasses import dataclass
from pathlib import Path

CLAUDE_TMP = next((p for p in (Path(f"/private/tmp/claude-{os.getuid()}"), Path(f"/tmp/claude-{os.getuid()}"))
                   if p.exists()), Path(f"/private/tmp/claude-{os.getuid()}"))
CONFIG_ROOTS = Path.home() / ".config" / "research-viewer" / "roots"   # one folder per line
STATE = Path.home() / ".cache" / "research-viewer"
QUEUE = STATE / "queue.txt"          # `show` from another pane appends paths here
PANE_FILE = STATE / "pane.json"      # {"pane_id", "pid"} of the running viewer
HISTORY_FILE = STATE / "history.jsonl"  # survives closing the pane; reopening restores it
HISTORY_KEEP = 300
LINK_PREFIXES = ("http://rv.localhost", "https://rv.localhost", "file://")
IMAGE = {".png", ".jpg", ".jpeg", ".gif", ".webp"}
TABLE = {".csv", ".parquet"}
TEXT = {".md", ".txt", ".json"}
OUTSIDE = {".html", ".htm", ".pdf", ".svg"}
SKIP_PARTS = {".git", ".venv", "node_modules", "__pycache__", "data", "cache"}
DEBOUNCE_S = 1.5
POPUP_MIN_GAP_S = 20
TABLE_ROWS = 40
SPLIT_RATIO = "0.45"


@dataclass
class Item:
    path: Path
    batch: int
    source: str          # "auto" (new file) or "show" (asked for)


def watch_roots() -> list[Path]:
    """Folders to follow: $RESEARCH_VIEWER_ROOTS (colon-separated), else the config file, else
    the directory the viewer was opened from. Claude Code scratchpads are always added."""
    env = os.environ.get("RESEARCH_VIEWER_ROOTS")
    if env:
        roots = [Path(x).expanduser() for x in env.split(":") if x]
    elif CONFIG_ROOTS.exists():
        roots = [Path(x.strip()).expanduser() for x in CONFIG_ROOTS.read_text().splitlines()
                 if x.strip() and not x.lstrip().startswith("#")]
    else:
        roots = [Path.cwd()]
    return [r for r in [*roots, CLAUDE_TMP] if r.exists()]


# ---------------------------------------------------------------- rendering
def term_size() -> tuple[int, int]:
    sz = shutil.get_terminal_size((100, 40))
    return sz.columns, sz.lines


def quicklook(path: Path) -> None:
    subprocess.Popen(["qlmanage", "-p", str(path)], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def draw_image(path: Path, reserve: int) -> None:
    cols, lines = term_size()
    sys.stdout.flush()
    subprocess.run(["chafa", "-f", "kitty", "--animate", "off",
                    "--size", f"{cols}x{max(lines - reserve, 8)}", str(path)], check=False)


def read_table(path: Path):
    import polars as pl
    return pl.read_parquet(path) if path.suffix.lower() == ".parquet" else pl.read_csv(path, infer_schema_length=2000)


def render(path: Path, pos: str = "", footer: bool = False) -> None:
    cols, _ = term_size()
    print("\033[2J\033[H", end="")
    print(f"\033[1m{path.name}\033[0m  {pos}  ·  {time.strftime('%H:%M:%S')}")
    print(str(path))
    print("─" * min(cols, 120))
    ext = path.suffix.lower()
    if not path.exists():
        print("file no longer exists")
    elif ext in IMAGE:
        draw_image(path, 7)
    elif ext in TABLE:
        import polars as pl
        df = read_table(path)
        pl.Config.set_tbl_width_chars(cols)
        pl.Config.set_tbl_rows(TABLE_ROWS)
        pl.Config.set_tbl_cols(min(df.width, 30))
        print(f"{df.height:,} rows × {df.width} cols   \033[2m(f = full scrollable view)\033[0m")
        print(df)
    elif ext in TEXT:
        print(path.read_text(errors="replace")[:20000])
    elif ext in OUTSIDE:
        # a terminal cannot lay out HTML/PDF/SVG: let Quick Look render a snapshot PNG, draw that
        snap = STATE / "snapshots"
        snap.mkdir(parents=True, exist_ok=True)
        subprocess.run(["qlmanage", "-t", "-s", "1600", "-o", str(snap), str(path)],
                       capture_output=True, timeout=30, check=False)
        png = snap / f"{path.name}.png"
        print("\033[2mstatic snapshot — press o for the live, scrollable version\033[0m")
        if png.exists():
            draw_image(png, 8)
        else:
            print("snapshot failed; press o to open it in Quick Look")
    else:
        print(f"no renderer for {ext}")
    if footer:
        print("\n\033[2m←/→ item  [/] batch  h history  f full  o open  l latest  q quit  x close\033[0m", end="")
    sys.stdout.flush()


def full_view(path: Path, key_fd: int, saved_tty) -> None:
    """Hand the terminal to a real scrolling viewer, then come back."""
    ext = path.suffix.lower()
    if ext in IMAGE | OUTSIDE:
        quicklook(path)
        return
    termios.tcsetattr(key_fd, termios.TCSADRAIN, saved_tty)
    try:
        if ext in TABLE and shutil.which("vd"):
            subprocess.run(["vd", str(path)], check=False)        # scroll, sort, filter; q to return
        elif ext in TABLE | TEXT:
            if ext in TABLE:
                import polars as pl
                df = read_table(path)
                with pl.Config(tbl_rows=-1, tbl_cols=-1, tbl_width_chars=100000, fmt_str_lengths=200):
                    text = str(df)
            else:
                text = path.read_text(errors="replace")
            subprocess.run(["less", "-S", "-R"], input=text.encode(), check=False)
    finally:
        tty.setcbreak(key_fd)


# ---------------------------------------------------------------- pane management
def herdr(*args: str) -> dict | None:
    try:
        out = subprocess.run(["herdr", *args], capture_output=True, text=True, timeout=10)
        return json.loads(out.stdout) if out.returncode == 0 and out.stdout.strip() else None
    except (OSError, ValueError, subprocess.TimeoutExpired):
        return None


def viewer_pane() -> str | None:
    """Pane id of a live viewer, or None."""
    try:
        info = json.loads(PANE_FILE.read_text())
        os.kill(info["pid"], 0)
    except (OSError, ValueError, KeyError):
        return None
    return info["pane_id"] if herdr("pane", "get", info["pane_id"]) else None


def open_viewer(popup: bool = False) -> str | None:
    pane = viewer_pane()
    if pane:
        return pane
    origin = os.environ.get("HERDR_PANE_ID")
    if not origin:
        print("not inside herdr; run `research-viewer watch` in any terminal instead")
        return None
    res = herdr("pane", "split", "--pane", origin, "--direction", "right", "--ratio", SPLIT_RATIO,
                "--cwd", os.getcwd())
    pane = res and res.get("result", {}).get("pane", {}).get("pane_id")
    if not pane:
        print("could not split a pane")
        return None
    herdr("pane", "run", pane, "research-viewer watch" + (" --popup" if popup else ""))
    for _ in range(40):                       # wait until the viewer registered itself
        if viewer_pane() == pane:
            break
        time.sleep(0.25)
    return pane


def close_viewer() -> None:
    pane = viewer_pane()
    if pane:
        herdr("pane", "close", pane)
    PANE_FILE.unlink(missing_ok=True)


def as_path(arg: str) -> Path:
    for pre in LINK_PREFIXES:
        if arg.startswith(pre):
            arg = arg[len(pre):]
            break
    from urllib.parse import unquote
    return Path(unquote(arg)).expanduser()


def enqueue(paths: list[Path]) -> None:
    STATE.mkdir(parents=True, exist_ok=True)
    with QUEUE.open("a") as f:
        for p in paths:
            f.write(str(p.resolve()) + "\n")


# ---------------------------------------------------------------- viewer loop
def wanted(p: Path) -> bool:
    """Auto-show only charts an agent produced: under the Claude Code temp tree that means a
    scratchpad, never the images/ folder where pasted screenshots land."""
    if p.suffix.lower() not in IMAGE or SKIP_PARTS & set(p.parts) or not p.exists():
        return False
    if CLAUDE_TMP in p.parents:
        return "scratchpad" in p.parts
    return True


def read_key(fd: int) -> str:
    ch = os.read(fd, 1).decode(errors="ignore")
    if ch == "\x1b":
        seq = os.read(fd, 2).decode(errors="ignore") if select.select([fd], [], [], 0.05)[0] else ""
        return {"[D": "p", "[C": "n"}.get(seq, "esc")
    return ch


def watch(popup: bool) -> None:
    STATE.mkdir(parents=True, exist_ok=True)
    QUEUE.write_text("")
    PANE_FILE.write_text(json.dumps({"pane_id": os.environ.get("HERDR_PANE_ID", ""), "pid": os.getpid()}))
    roots = watch_roots()
    proc = subprocess.Popen(["fswatch", "-0", "-r", "--event", "Created", "--event", "Updated",
                             "--event", "Renamed", "--event", "MovedTo", *map(str, roots)],
                            stdout=subprocess.PIPE)
    assert proc.stdout is not None
    fs_fd, key_fd = proc.stdout.fileno(), sys.stdin.fileno()
    history: list[Item] = []
    idx, batch_no = -1, 0
    pending: dict[Path, float] = {}
    buf, last_popup = b"", 0.0
    saved_tty = termios.tcgetattr(key_fd)
    tty.setcbreak(key_fd)

    def goto(i: int) -> None:
        nonlocal idx
        if history:
            idx = max(0, min(i, len(history) - 1))
            it = history[idx]
            nb = history[-1].batch
            render(it.path, f"[{idx + 1}/{len(history)}  batch {it.batch}/{nb}  {it.source}]", footer=True)

    def goto_batch(step: int) -> None:
        if not history:
            return
        target = history[idx].batch + step
        members = [i for i, it in enumerate(history) if it.batch == target]
        if members:
            goto(members[-1])

    def add(paths: list[Path], source: str) -> None:
        nonlocal batch_no
        batch_no += 1
        new = [Item(p, batch_no, source) for p in sorted(paths, key=lambda q: q.stat().st_mtime if q.exists() else 0)]
        history.extend(new)
        with HISTORY_FILE.open("a") as f:
            for it in new:
                f.write(json.dumps({"path": str(it.path), "batch": it.batch, "source": it.source}) + "\n")
        goto(len(history) - 1)

    # restore the previous session's history (last HISTORY_KEEP items, files that still exist)
    if HISTORY_FILE.exists():
        rows = [json.loads(x) for x in HISTORY_FILE.read_text().splitlines()[-HISTORY_KEEP:] if x.strip()]
        HISTORY_FILE.write_text("".join(json.dumps(r) + "\n" for r in rows))
        remap: dict[int, int] = {}
        for r in rows:
            if Path(r["path"]).exists():
                remap.setdefault(r["batch"], len(remap) + 1)
                history.append(Item(Path(r["path"]), remap[r["batch"]], r["source"]))
        batch_no = len(remap)

    def history_menu() -> None:
        print("\033[2J\033[H\033[1mhistory\033[0m  (number + Enter to open, Esc/h to go back)\n")
        last_b = None
        for i, it in enumerate(history):
            if it.batch != last_b:
                print(f"\033[2m── batch {it.batch} ({it.source})\033[0m")
                last_b = it.batch
            mark = "▶" if i == idx else " "
            print(f" {mark}{i + 1:>3}  {it.path.name}   \033[2m{it.path.parent}\033[0m")
        print("\n> ", end="", flush=True)
        typed = ""
        while True:
            k = read_key(key_fd)
            if k in ("esc", "h", "q"):
                goto(idx)
                return
            if k in ("\n", "\r"):
                if typed.isdigit():
                    goto(int(typed) - 1)
                else:
                    goto(idx)
                return
            if k.isdigit():
                typed += k
                print(k, end="", flush=True)
            elif k in ("\x7f", "\b") and typed:
                typed = typed[:-1]
                print("\b \b", end="", flush=True)

    if history:
        goto(len(history) - 1)
    else:
        print("watching for new charts in:\n  " + "\n  ".join(map(str, roots)))
        print("\n\033[2mno history yet — waiting for the first chart (q quit, x close pane)\033[0m",
              end="", flush=True)
    try:
        while True:
            ready, _, _ = select.select([fs_fd, key_fd], [], [], 0.3)
            now = time.time()
            if fs_fd in ready:
                chunk = os.read(fs_fd, 65536)
                *items, buf = (buf + chunk).split(b"\0")
                for raw in items:
                    p = Path(raw.decode(errors="replace"))
                    if wanted(p):
                        pending[p] = now
            if key_fd in ready:
                k = read_key(key_fd)
                if k == "p":
                    goto(idx - 1)
                elif k == "n":
                    goto(idx + 1)
                elif k == "[":
                    goto_batch(-1)
                elif k == "]":
                    goto_batch(+1)
                elif k == "l":
                    goto(len(history) - 1)
                elif k == "h" and history:
                    history_menu()
                elif k == "f" and history:
                    full_view(history[idx].path, key_fd, saved_tty)
                    goto(idx)
                elif k == "o" and history:
                    quicklook(history[idx].path)
                elif k == "q":
                    break
                elif k == "x":
                    PANE_FILE.unlink(missing_ok=True)
                    herdr("pane", "close", os.environ.get("HERDR_PANE_ID", ""))
                    break
            if QUEUE.exists() and QUEUE.stat().st_size:
                req = [Path(x) for x in QUEUE.read_text().splitlines() if x.strip()]
                QUEUE.write_text("")
                add(req, "show")
            if pending and now - max(pending.values()) >= DEBOUNCE_S:
                batch = [p for p in pending if p.exists()]
                pending.clear()
                if batch:
                    add(batch, "auto")
                    if popup and now - last_popup >= POPUP_MIN_GAP_S:
                        quicklook(history[-1].path)
                        last_popup = now
    finally:
        termios.tcsetattr(key_fd, termios.TCSADRAIN, saved_tty)
        proc.terminate()
        PANE_FILE.unlink(missing_ok=True)
        print()


def main(argv: list[str]) -> None:
    cmd, rest = (argv[0], argv[1:]) if argv else ("", [])
    if cmd == "watch":
        watch("--popup" in rest)
    elif cmd == "open":
        open_viewer("--popup" in rest)
    elif cmd == "close":
        close_viewer()
    elif cmd == "toggle":
        close_viewer() if viewer_pane() else open_viewer()
    elif cmd == "show" and rest:
        paths = [as_path(a) for a in rest]
        here = os.environ.get("HERDR_PANE_ID")
        if here and here == viewer_pane():
            for p in paths:
                render(p.resolve())
        elif open_viewer():
            enqueue(paths)
        else:
            for p in paths:
                render(p.resolve())
    else:
        print(__doc__)


if __name__ == "__main__":
    main(sys.argv[1:])
